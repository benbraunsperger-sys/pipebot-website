NEOKENS_API_KEY=replace-with-your-neokens-v2-key
NEOKENS_BASE_URL=https://api.v2.neokens.com/v1
NEOKENS_MODEL=gpt-5.6-sol
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=optional-google-search-console-token

# Required in production for shared, atomic API rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use at least 32 random bytes. Store as a secret in Railway, never commit a real value.
CLIENT_IP_HMAC_SECRET=

# Cloudflare Turnstile. The site key is public; the secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=pipebot.at,www.pipebot.at
